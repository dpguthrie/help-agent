DATABASE_URL=postgresql://sfdc:sfdc@localhost:5432/sfdc
BRAINTRUST_API_KEY=sk-your-key-here
CLASSIFIER_MODEL=claude-haiku-4-5
EXECUTOR_MODEL=claude-sonnet-4-5
EMBEDDING_MODEL=text-embedding-3-small
CLASSIFIER_TEMPERATURE=0.0
EXECUTOR_TEMPERATURE=0.2
EXECUTOR_MAX_TOKENS=4096

# Simulator service (optional)
SIMULATOR_CADENCE=300
SIMULATOR_BATCH_SIZE=5
SIMULATOR_CONCURRENCY=3
SIMULATOR_MODEL=gpt-5-nano
SIMULATOR_AGENT_MODEL=
SIMULATOR_ENABLED=true
